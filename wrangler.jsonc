{
  // 로컬 개발·빌드용 설정입니다. 선생님 계정에 설치할 때는 설치 프로그램(installer/)이 같은 설정으로 올립니다
  // (installer/src/app-manifest.ts의 COMPATIBILITY_DATE·FLAGS와 맞출 것).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mandalart",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "mandalart-db", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "vars": { "APP_VERSION": "2.0.0" },
  "alias": {
    "next/headers": "./worker/shims/next-headers.ts",
    "next/navigation": "./worker/shims/next-navigation.ts",
    "server-only": "./worker/shims/empty.ts"
  },
  "observability": { "enabled": false }
}
