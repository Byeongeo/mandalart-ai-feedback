{
  "name": "mandalart-cf",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build && node scripts/embed-assets.mjs",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/app",
    "dev": "npm run build:web && wrangler dev",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
