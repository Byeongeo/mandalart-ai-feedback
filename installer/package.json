{
  "name": "mandalart-installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "선생님이 자기 Cloudflare 계정에 'AI 만다라트 피드백' 앱을 설치·업데이트하는 설치 페이지(Worker)",
  "scripts": {
    "embed": "node scripts/embed-app.mjs",
    "build": "npm run embed && wrangler deploy --dry-run --outdir dist",
    "dev": "npm run embed && wrangler dev --local --port 8789",
    "deploy": "npm run embed && wrangler deploy",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "e2e": "node test/e2e.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
