# 설정 견본입니다. 실제 값(비밀번호, API 키)은 이 파일에 적지 마세요.
# - Vercel에 배포할 때: 아래 값은 Vercel 프로젝트 > Settings > Environment Variables 에만 넣습니다.
#   'Deploy' 버튼으로 설치하면 OPENROUTER_API_KEY와 SETUP_TOKEN만 직접 넣으면 되고, DB 주소는 Neon이 자동으로 넣습니다.
#   값을 바꾼 뒤에는 Deployments > 맨 위 항목 > Redeploy 를 눌러야 적용됩니다.
# - 내 컴퓨터에서 실행할 때(개발자용): `cp .env.example .env.local` 로 복사한 뒤 값을 채웁니다.

# ── 데이터베이스 ─────────────────────────────────────────────
# Vercel Marketplace의 Neon 연동이 자동으로 넣습니다(직접 넣지 않아도 됩니다).
# 연결 풀(PgBouncer) 주소이며 sslmode=require가 붙어 있습니다.
# Neon 연동에 따라 예전 이름 POSTGRES_URL이 함께 들어올 수도 있으며, 앱은 DATABASE_URL이 없을 때만 그것을 씁니다.
# Vercel에서 Neon을 연결(Connect)할 때 환경 변수 접두사(prefix)는 바꾸지 마세요. 바꾸면 두 이름이 모두 없어 앱이 DB를 찾지 못합니다.
# 로컬에서는 Neon 콘솔 > Connect 에서 'Pooled connection' 문자열을 복사해 넣습니다.
DATABASE_URL=

# ── 꼭 넣어야 하는 값 ────────────────────────────────────────
# OpenRouter API 키(https://openrouter.ai/settings/keys). 서버에서만 쓰이고 학생 화면으로 보내지 않습니다.
# 키를 만들 때 사용 한도(credit limit)를 꼭 걸어 두세요.
OPENROUTER_API_KEY=

# 설정 코드. 16자 이상이어야 하고, 20자 이상 무작위를 권합니다(앞뒤 빈칸은 무시).
# 첫 교사 계정을 만들 때와 교사 비밀번호를 잊어 다시 정할 때(/teacher/setup) 입력합니다.
# 계정을 만든 뒤에도 비밀번호를 다시 정하는 마스터 키로 계속 쓰이므로 지우지 말고, 다른 사람에게 알려 주지 마세요. 새어 나가면 바로 바꾸세요.
# 예: 비밀번호 관리자의 '비밀번호 생성'으로 20자 이상, 또는 터미널에서 `openssl rand -hex 16`.
SETUP_TOKEN=

# ── 선택(비워 두면 기본값) ───────────────────────────────────
# 로그인 유지에 쓰는 비밀 문자열(32자 이상). 보통 비워 둡니다. 비워 두면 앱이 만들어 데이터베이스에 저장해 씁니다.
# 직접 넣었다면 나중에 바꾸지 마세요. 바꾸면 교사와 학생 모두 다시 로그인해야 합니다(쓴 글은 그대로).
SESSION_SECRET=

# 사용할 AI 모델 ID(https://openrouter.ai/models 에서 복사). 비워 두면 anthropic/claude-haiku-5.5
# 틀린 ID를 넣으면 피드백이 모두 실패합니다. 교사 화면의 'AI 연결 확인'으로 확인하세요.
# 학생 글을 보관하지 않으면서(ZDR) JSON 응답 형식도 지원하는 제공사가 있는 모델이어야 합니다(이 조건은 끌 수 없음).
OPENROUTER_MODEL=

# 사용할 제공사 이름(쉼표로 구분, 모델 페이지 Providers 탭의 이름). 비워 두면 OpenRouter가 고릅니다.
# 넣으면 그 제공사만 씁니다(ZDR 조건은 그대로). 'AI 연결 확인'에 맞는 제공사가 없다고 나오면 비우세요.
OPENROUTER_PROVIDERS=

# 추론 노력 수준: low / medium / high, none(추론 설정을 보내지 않음). 비워 두면 low.
OPENROUTER_REASONING_EFFORT=

# OpenRouter API 주소. 비워 두면 기본 주소(https://openrouter.ai/api/v1)를 씁니다. 보통 바꿀 필요가 없습니다.
OPENROUTER_BASE_URL=

# ── 개발용 ──────────────────────────────────────────────────
# 1이면 AI를 부르지 않고 모의 피드백을 보여 줍니다(API 키 없이 화면 확인용). 운영 배포에서는 무시됩니다.
FEEDBACK_MOCK=0
