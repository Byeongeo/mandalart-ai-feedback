{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "installer", "src/app/**/page.tsx", "src/app/layout.tsx", "src/app/error.tsx", "src/app/global-error.tsx", "src/app/not-found.tsx"]
}
